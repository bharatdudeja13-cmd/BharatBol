# Copy to .env and fill in from your Supabase project (Settings → API).
# Without these, the app runs in a local demo mode with sample data.
VITE_SUPABASE_URL=
# Either key format works here: the new sb_publishable_... publishable key
# (recommended) or the legacy eyJ... anon JWT.
VITE_SUPABASE_ANON_KEY=
# Public URL of the deployed site (used on share cards).
VITE_SITE_URL=https://bharatbol.pages.dev
# Public GitHub repository (shown on the About page).
VITE_REPO_URL=https://github.com/bharatdudeja13-cmd/BharatBol
