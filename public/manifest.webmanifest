{
  "name": "BharatBol — भारत बोल",
  "short_name": "BharatBol",
  "description": "An independent, non-partisan civic square where any Indian citizen can speak on an issue and be counted.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F3F5F9",
  "theme_color": "#15305E",
  "lang": "en",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/add",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Add to feed",
      "short_name": "Add",
      "url": "/add"
    },
    {
      "name": "Feed",
      "short_name": "Feed",
      "url": "/feed"
    }
  ]
}
